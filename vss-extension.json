{
  "manifestVersion": 1,
  "id": "projectreactapp",
  "version": "1.0.1",
  "name": "Raj proj react",
  "publisher": "projectreactapp",
  "public": true,
  "description": "Custom Azure DevOps extension with a hub and tab page",
  "icons": {
    "default": "images/icon.png"
  },
    "content": {
        "details": {
            "path": "overview/overview.md"
        }
       
    },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true
    }
 
  ],
  "contributions": [
    {
      "id": "raj-hub-group",
      "type": "ms.vss-web.hub-group",
      "properties": {
        "name": "Raj Tools"
      }
    },
    {
      "id": "raj-page",
      "type": "ms.vss-work-web.work-item-form-control",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "Raj Page",
	"height": 50,
        "uri": "dist/index.html"
      }
    },
    {
      "id": "raj-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.repository-tabs"],
      "properties": {
        "name": "Raj Tab",
        "uri": "dist/tab.html",
        "title": "Raj Custom Repo Tab"
      }
    }
  ],
  "categories": [
    "Azure Boards"
  ]
}
